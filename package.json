{
  "name": "opportunity-inbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"lib/**/*.test.ts\"",
    "eval:extraction": "node scripts/eval-extraction.ts",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "eval": "node --env-file=.env.local --import ./scripts/loader/register.mjs scripts/eval.ts",
    "eval:purge": "node --env-file=.env.local --import ./scripts/loader/register.mjs scripts/eval.ts purge",
    "eval:label": "node --env-file=.env.local --import ./scripts/loader/register.mjs scripts/label-server.ts",
    "eval:audit": "node --env-file=.env.local --import ./scripts/loader/register.mjs scripts/label-audit.ts",
    "reader": "node --env-file=.env.local --import ./scripts/loader/register.mjs scripts/reader-shadow.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
