AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=
DATABASE_URL=postgresql://opportunity:opportunity@localhost:5432/opportunity_inbox
# 32-byte key as 64 hex characters: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Comma-separated emails allowed to view /admin/validation
ADMIN_EMAILS=

# Architecture v2 shadow mode (docs/architecture-v2-shadow.md). All optional; shadow mode is OFF unless the flag is exactly 1.
# READER_V2_SHADOW=1
# Messages arriving at or after this instant are the prospective cohort (docs/prospective-evaluation-protocol.md), e.g. 2026-11-16T00:00:00Z
# READER_V2_CUTOFF=
# Fraction of mail assigned to the deterministic uniform sample arm (default 0.05)
# READER_V2_UNIFORM_RATE=
# Comma-separated name tokens removed from model inputs by redaction (the account holder's own name). Required for `npm run shadow -- export`.
# READER_SELF_NAMES=
# Blocks ALL product sync (including the automatic first sync) while an evaluation mailbox must stay untouched. See app/sync-lock.ts.
# BLIND_SETUP_LOCK=1
