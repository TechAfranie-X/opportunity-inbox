AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=
DATABASE_URL=postgresql://opportunity:opportunity@localhost:5432/opportunity_inbox
# 32-byte key as 64 hex characters: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Comma-separated emails allowed to view /admin/validation
ADMIN_EMAILS=

# Architecture v2 shadow mode (docs/architecture-v2-shadow.md). All optional; shadow mode is OFF unless the flag is exactly 1.
# READER_V2_SHADOW=1
# The prospective cutoff and sampling rate are frozen constants (lib/recruiting/shadow/frozen.ts), not configuration.
# Comma-separated name tokens removed from model inputs by redaction (the account holder's own name). Required for `npm run shadow -- export`.
# READER_SELF_NAMES=
# Blocks ALL product sync (including the automatic first sync) while an evaluation mailbox must stay untouched. See app/sync-lock.ts.
# BLIND_SETUP_LOCK=1

# Candidate discovery (docs/discovery-v2.md). Unset = the original keyword search. "sweep" also reads everything outside Gmail's
# Promotions/Social/Forums (keyword hits first). Bodies stay in memory; rejected sweep mail is remembered by id only.
# DISCOVERY=sweep

# Development only: lets you sign in with a synthetic sample mailbox (no Gmail). Ignored when NODE_ENV=production.
# SAMPLE_LOGIN=1
# With the sample login, SAMPLE_LARGE=1 adds about 100 more synthetic opportunities, to see the product with a dense pipeline.
# SAMPLE_LARGE=1
# After the prospective evaluation has finished, set to "off" to read Gmail mail received on or after 2026-12-01.
# EVAL_EMBARGO=off
