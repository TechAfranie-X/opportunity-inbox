#!/bin/sh
# 1. Evaluation seatbelt (docs/development-workflow.md). On the `main` branch only documentation and the guard tooling may change;
# everything else is the frozen evaluation environment. Product work belongs on the `mvp` branch. Override: FREEZE_OVERRIDE=1.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] && [ "$FREEZE_OVERRIDE" != "1" ]; then
  bad=$(git diff --cached --name-only | grep -v -E '^(docs/|\.githooks/|scripts/freeze-guard|README\.md$|package\.json$|\.gitignore$)')
  if [ -n "$bad" ]; then
    echo "refusing to commit to main: these paths belong to the frozen evaluation environment:" >&2
    echo "$bad" | sed 's/^/  - /' >&2
    echo "Do product work on the mvp branch (separate worktree). See docs/development-workflow.md." >&2
    exit 1
  fi
fi

# 2. Decision-logic gate. Staged changes to how mail is read, decided or turned into a lifecycle must pass the cached-replay regression gate (eval/baseline.json).
changed=$(git diff --cached --name-only | grep -E '^(lib/(recruiting|reliability|semantic|lifecycle|identity|decision|ledger|discovery)/|eval/dev/|scripts/eval-)' | grep -vE '\.test\.ts$' || true)
[ -z "$changed" ] && exit 0
echo "pre-commit: decision-logic files staged; running the cached-replay gate (npm run eval:gate)"
npm run --silent eval:gate || { echo "pre-commit: the eval gate failed. Fix the regression, or (rarely, deliberately) rewrite the baseline with --write-baseline and say why in the commit." >&2; exit 1; }
exit 0
